{
  "name": "power-automate",
  "version": "0.1.0",
  "private": true,
  "main": "electron/electron-entry.js",
  "scripts": {
    "electron:dev": "concurrently \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "start": "next start",
    "lint": "eslint",
    "dev": "next dev",
    "build:next": "next build",
    "postbuild:next": "cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "build:electron": "tsc electron/electron-entry.ts",
    "build": "pnpm run build:next && pnpm run postbuild:next && pnpm run build:electron",
    "preview:desktop": "NODE_ENV=production pnpm exec electron .",
    "dist": "npm run build:next && npm run postbuild:next && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win"
  },
  "dependencies": {
    "@formkit/tempo": "^1.0.0",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "docx-preview": "^0.3.7",
    "easy-template-x": "^7.0.3",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.power.automate",
    "productName": "PowerAutomate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "asar": true
  }
}