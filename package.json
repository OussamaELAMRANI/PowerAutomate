{
  "name": "power-automate",
  "version": "1.0.0",
  "private": true,
  "main": "./electron/electron-entry.js",
  "type": "module",
  "author": {
    "name": "PowerAutomate Team",
    "email": "dev@powerautomate.app"
  },
  "description": "Document automation desktop app — generate, manage, and process templates.",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "build:next": "next build",
    "postbuild": "node electron/postbuild.mjs",
    "build": "pnpm run build:next && pnpm run postbuild",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "preview:desktop": "pnpm run build && cross-env NODE_ENV=production electron .",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:all": "pnpm run build && electron-builder --linux --win --mac"
  },
  "dependencies": {
    "@formkit/tempo": "^1.0.0",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "docx-preview": "^0.3.7",
    "easy-template-x": "^7.0.3",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.power.automate",
    "productName": "PowerAutomate",
    "afterPack": "./electron/afterPack.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/standalone/**",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "asarUnpack": []
  }
}